{
  "name": "wellbusiness",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "clientes/*",
    "apps/*"
  ],
  "scripts": {
    "build:web": "npm run build -w apps/web",
    "deploy:web": "cd apps/web && npx wrangler deploy",
    "dev:web": "npm run dev -w apps/web",
    "check:web": "npm run check -w apps/web",
    "build:portal": "npm run build -w apps/portal",
    "deploy:portal": "cd apps/portal && npx wrangler deploy",
    "dev:portal": "npm run dev -w apps/portal",
    "check:portal": "npm run check -w apps/portal",
    "version:web": "cd apps/web && npx wrangler versions upload",
    "version:portal": "cd apps/portal && npx wrangler versions upload"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
