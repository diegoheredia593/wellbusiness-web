---
/**
 * Catalog overview tile: cover photo (first image) + name only. The whole
 * card links to the product's detail page (`/catalogo/[slug]`), where the
 * full gallery/specs/CTA live — this stays deliberately minimal, like a
 * category grid in an e-commerce site.
 */
import ImagePlaceholder from "./ImagePlaceholder.astro";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import type { Product } from "../data/types";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const cover = product.images[0];
---

<a
  href={`/catalogo/${product.slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-brand-mist bg-white shadow-brand-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-brand-md"
  data-reveal
  data-category={product.category}
>
  <div class="relative aspect-square overflow-hidden bg-white">
    {cover ? (
      <img
        src={cover}
        alt={product.name}
        class="h-full w-full object-contain p-8 transition-transform duration-500 ease-out group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <ImagePlaceholder class="h-full w-full" icon="radio-handheld" note={`Fotografía de ${product.name}`} />
    )}
    {product.isPlaceholder && (
      <span class="absolute left-3 top-3">
        <Badge tone="mist">Ejemplo</Badge>
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-base font-semibold leading-snug text-brand-ink">{product.name}</h3>
    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-brand-steel">
      {product.type} · {product.band}
    </p>
    <p class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-brand-ink transition-colors group-hover:text-brand-steel">
      Ver detalle
      <Icon name="chevron-right" class="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
    </p>
  </div>
</a>
