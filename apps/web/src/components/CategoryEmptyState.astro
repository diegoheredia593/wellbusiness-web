---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { contactHref } from "../utils/url";
import type { IconName, ProductCategory } from "../data/types";

interface Props {
  category: ProductCategory;
}
const { category } = Astro.props;

// Las categorías ahora son editables desde el portal — a diferencia de las
// 4 fijas de antes, una nueva categoría sin ícono mapeado aquí no debe
// romper la página, solo cae al ícono genérico.
const icons: Record<string, IconName> = {
  "Radios portátiles": "radio-handheld",
  "Radios móviles y estaciones base": "radio-mobile",
  Repetidoras: "tower",
  "Accesorios originales": "accessory",
};
const icon = icons[category] ?? "radio-handheld";
---

<div
  class="flex flex-col items-center gap-4 rounded-2xl border-2 border-dashed border-brand-mist bg-white/60 px-6 py-14 text-center"
  data-category={category}
  data-reveal
>
  <span class="flex size-14 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
    <Icon name={icon} class="size-6" />
  </span>
  <div class="max-w-sm">
    <h3 class="font-display text-lg font-semibold text-brand-ink">Ficha en preparación</h3>
    <p class="mt-2 text-sm leading-relaxed text-brand-slate">
      Estamos incorporando las fichas de <strong>{category.toLowerCase()}</strong> con datos verificados. Cuéntanos
      qué necesitas y te confirmamos los modelos disponibles en esta categoría.
    </p>
  </div>
  <Button href={contactHref({ motive: "Catálogo Motorola", product: category })} variant="ghost" size="md">
    Consultar disponibilidad
  </Button>
</div>
