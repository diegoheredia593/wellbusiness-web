---
import Badge from "./Badge.astro";
import type { CoverageZone } from "../data/types";

interface Props {
  zone: CoverageZone;
  index?: number;
}
const { zone, index = 0 } = Astro.props;
---

<article
  class="flex flex-col gap-3 rounded-2xl border border-brand-mist bg-white p-6"
  data-reveal
  style={`animation-delay:${(index % 3) * 90}ms`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-display text-lg font-semibold text-brand-ink">{zone.title}</h3>
    <Badge tone="outline" class="shrink-0">Referencial</Badge>
  </div>
  <p class="text-sm leading-relaxed text-brand-slate">{zone.description}</p>
  {zone.interestNote && (
    <p class="text-sm leading-relaxed text-brand-steel-dark">{zone.interestNote}</p>
  )}
</article>
