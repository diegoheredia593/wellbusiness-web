---
/**
 * Astro no permite `Astro.rewrite()` hacia una ruta prerenderizada desde
 * una ruta dinámica (p. ej. `/catalogo/[slug]` cuando el producto no
 * existe) — error real, confirmado en vivo ("ForbiddenRewrite"). Por eso
 * esta página es `prerender = false` a pesar de que su contenido sigue
 * siendo 100% fijo en código (nunca llama a `getBlocks()`/D1) — el 404
 * debe seguir funcionando aunque D1 no esté disponible, eso no cambió,
 * solo cambió CÓMO se renderiza (en cada request, no en el build), para
 * poder ser el destino de un rewrite real.
 */
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 text-center sm:px-8">
    <span class="mb-6 flex size-16 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
      <Icon name="signal" class="size-8" />
    </span>
    <h1 class="font-display text-3xl font-bold text-brand-ink">No encontramos esta página</h1>
    <p class="mt-4 text-base leading-relaxed text-brand-slate">
      El contenido que buscas no está disponible o cambió de dirección. Vuelve al inicio o solicita asesoría
      directamente con nuestro equipo.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Button href="/" variant="secondary">Volver al inicio</Button>
      <Button href="/contacto" variant="primary">Solicitar asesoría</Button>
    </div>
  </section>
</BaseLayout>
