---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { getBlocks, marcaDe, contactoDe, getServicios } from "../lib/content";
import { contactHref } from "../utils/url";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const servicios = await getServicios();
---

<BaseLayout
  title="Servicios"
  description={b.t('servicios.meta.descripcion')}
  marca={marca}
  contacto={contacto}
>
  <PageHero
    eyebrow={b.t('servicios.hero.eyebrow')}
    title={b.t('servicios.hero.titulo')}
    description={b.t('servicios.hero.descripcion')}
  />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((service, i) => <ServiceCard service={service} index={i} />)}
    </div>
  </section>

  <CtaBanner
    title={b.t('servicios.cta.titulo')}
    description={b.t('servicios.cta.descripcion')}
    ctaLabel={b.t('servicios.cta.ctaLabel')}
    ctaHref={contactHref()}
  />
</BaseLayout>
