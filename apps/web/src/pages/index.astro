---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Badge from "../components/Badge.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import QuickLinkCard from "../components/QuickLinkCard.astro";
import SectorCard from "../components/SectorCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import MotorolaBadge from "../components/MotorolaBadge.astro";
import HeroProductCollage from "../components/HeroProductCollage.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { getBlocks, marcaDe, contactoDe, getSectores, getZonasCobertura, getMarcas, getAccesosRapidos } from "../lib/content";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const [sectores, zonas, marcas, accesos] = await Promise.all([
  getSectores(),
  getZonasCobertura(),
  getMarcas(),
  getAccesosRapidos(),
]);
---

<BaseLayout title="Wellbusiness" description={b.t('inicio.meta.descripcion')} marca={marca} contacto={contacto}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-brand-ink">
    <div class="absolute inset-0 bg-radio-grid opacity-[0.07]"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2 lg:items-center lg:gap-8">
      <div data-reveal>
        <MotorolaBadge label={marca.dealerMotorola} variant="chip" />
        <h1 class="mt-6 font-display text-4xl font-bold leading-[1.1] text-white sm:text-5xl lg:text-[3.4rem]">
          {b.t('inicio.hero.titulo')}
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/70">
          {b.t('inicio.hero.descripcion')}
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href="/contacto" variant="primary" size="lg">{b.t('inicio.hero.ctaPrincipal')}</Button>
          <Button href="/catalogo" variant="light" size="lg">{b.t('inicio.hero.ctaSecundaria')}</Button>
        </div>
      </div>

      <div class="relative" data-reveal style="animation-delay:120ms">
        <HeroProductCollage class="aspect-[4/3]" />
        <div class="absolute -bottom-6 -left-6 hidden rounded-2xl bg-white px-5 py-4 shadow-brand-lg sm:block">
          <img
            src="/images/brand/motorola-authorized-dealer.png"
            alt="Motorola Authorized Two-Way Radio Dealer"
            class="h-11 w-auto"
            width="2428"
            height="791"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- MARCAS Y TECNOLOGÍA -->
  <section class="border-b border-brand-mist bg-white py-10">
    <div class="mx-auto max-w-7xl px-5 sm:px-8" data-reveal>
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.14em] text-brand-slate">
        {b.t('inicio.marcas.etiqueta')}
      </p>
      <LogoMarquee logos={marcas} />
    </div>
  </section>

  <!-- INTRODUCCIÓN -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <SectionHeading
        eyebrow={b.t('inicio.trabajo.eyebrow')}
        title={b.t('inicio.trabajo.titulo')}
        description={b.t('inicio.trabajo.descripcion')}
      />
      <div class="grid gap-4 sm:grid-cols-2" data-reveal style="animation-delay:80ms">
        {[
          { icon: "radio-handheld" as const, label: b.t('inicio.trabajo.item1') },
          { icon: "map" as const, label: b.t('inicio.trabajo.item2') },
          { icon: "wrench" as const, label: b.t('inicio.trabajo.item3') },
          { icon: "compass" as const, label: b.t('inicio.trabajo.item4') },
        ].map((item) => (
          <div class="flex items-start gap-3 rounded-2xl border border-brand-mist bg-white p-5">
            <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-brand-steel-light text-brand-steel-dark">
              <Icon name={item.icon} class="size-4.5" />
            </span>
            <p class="text-sm font-medium leading-snug text-brand-ink">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ACCESO RÁPIDO A SOLUCIONES -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <SectionHeading title={b.t('inicio.accesos.titulo')} align="center" class="mx-auto" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {accesos.map((acceso, i) => (
          <QuickLinkCard
            index={i}
            icon={acceso.icon}
            title={acceso.title}
            description={acceso.description}
            href={acceso.href}
            linkLabel={acceso.linkLabel}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SECTORES -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
    <SectionHeading
      eyebrow={b.t('inicio.sectores.eyebrow')}
      title={b.t('inicio.sectores.titulo')}
      description={b.t('inicio.sectores.descripcion')}
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {sectores.map((sector, i) => <SectorCard sector={sector} index={i} />)}
    </div>
    <div class="mt-8">
      <Button href="/sectores" variant="ghost" withArrow class="group">{b.t('inicio.sectores.ctaLabel')}</Button>
    </div>
  </section>

  <!-- COBERTURA TEASER -->
  <section class="bg-brand-mist/60 py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <SectionHeading
          eyebrow={b.t('inicio.cobertura.eyebrow')}
          title={b.t('inicio.cobertura.titulo')}
          description={b.t('inicio.cobertura.descripcion')}
        />
        <div class="flex flex-wrap gap-2.5" data-reveal>
          {zonas.map((zone) => (
            <Badge tone="steel">{zone.title.split("·")[1]?.trim() ?? zone.title}</Badge>
          ))}
        </div>
      </div>
      <div class="mt-8">
        <Button href="/cobertura" variant="secondary" withArrow class="group">{b.t('inicio.cobertura.ctaLabel')}</Button>
      </div>
    </div>
  </section>

  <CtaBanner
    title={b.t('inicio.cta.titulo')}
    description={b.t('inicio.cta.descripcion')}
    ctaLabel={b.t('inicio.cta.ctaLabel')}
    ctaHref="/contacto"
  />
</BaseLayout>
