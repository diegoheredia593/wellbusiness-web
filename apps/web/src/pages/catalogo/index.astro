---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProductCoverCard from "../../components/ProductCoverCard.astro";
import CategoryEmptyState from "../../components/CategoryEmptyState.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import Button from "../../components/Button.astro";
import MotorolaBadge from "../../components/MotorolaBadge.astro";
import { getBlocks, marcaDe, contactoDe, getProductos, getCategorias } from "../../lib/content";
import { contactHref } from "../../utils/url";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const [productos, categorias] = await Promise.all([getProductos(), getCategorias()]);

const categoriesWithCount = categorias.map((category) => ({
  category,
  products: productos.filter((p) => p.category === category),
}));
---

<BaseLayout
  title="Catálogo Motorola"
  description={b.t('catalogo.meta.descripcion')}
  marca={marca}
  contacto={contacto}
>
  <PageHero
    eyebrow={b.t('catalogo.hero.eyebrow')}
    title={b.t('catalogo.hero.titulo')}
    description={b.t('catalogo.hero.descripcion')}
  >
    <MotorolaBadge label={marca.dealerMotorola} variant="chip" />
  </PageHero>

  <div class="mx-auto max-w-7xl px-5 pt-8 sm:px-8">
    <p class="rounded-xl bg-brand-steel-light px-4 py-3 text-center text-sm font-medium text-brand-steel-dark">
      {b.t('catalogo.aviso.texto')}
    </p>
  </div>

  <section class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
    <!-- Filter tabs -->
    <div id="catalog-filters" class="mb-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Filtrar catálogo por categoría">
      <button type="button" data-filter="all" aria-pressed="true"
        class="filter-tab rounded-full border border-brand-ink bg-brand-ink px-4 py-2 text-sm font-semibold text-white transition-colors">
        Todas
      </button>
      {categorias.map((category) => (
        <button type="button" data-filter={category} aria-pressed="false"
          class="filter-tab rounded-full border border-brand-mist px-4 py-2 text-sm font-semibold text-brand-ink-soft transition-colors hover:border-brand-steel">
          {category}
        </button>
      ))}
    </div>

    {categoriesWithCount.map(({ category, products }) => (
      <div class="catalog-section mb-16 last:mb-0" data-category={category}>
        <SectionHeading title={category} class="mb-6" />
        {products.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => <ProductCoverCard product={product} />)}
          </div>
        ) : (
          <CategoryEmptyState category={category} />
        )}
      </div>
    ))}
  </section>

  <!-- ASESORÍA DE PRODUCTO -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
      <SectionHeading align="center" class="mx-auto" title={b.t('catalogo.asesoria.titulo')} />
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-brand-slate">
        {b.t('catalogo.asesoria.descripcion')}
      </p>
      <div class="mt-7">
        <Button href={contactHref({ motive: "Catálogo Motorola" })} variant="primary" size="lg">
          {b.t('catalogo.asesoria.ctaLabel')}
        </Button>
      </div>
    </div>
  </section>

  <CtaBanner
    title={b.t('catalogo.cta.titulo')}
    description={b.t('catalogo.cta.descripcion')}
    ctaLabel={b.t('catalogo.cta.ctaLabel')}
    ctaHref={contactHref({ motive: "Catálogo Motorola" })}
  />
</BaseLayout>

<script>
  function initCatalogFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
    const sections = document.querySelectorAll<HTMLElement>(".catalog-section");
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.dataset.filter;

        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute("aria-pressed", String(active));
          t.classList.toggle("bg-brand-ink", active);
          t.classList.toggle("text-white", active);
          t.classList.toggle("border-brand-ink", active);
          t.classList.toggle("text-brand-ink-soft", !active);
          t.classList.toggle("border-brand-mist", !active);
        });

        sections.forEach((section) => {
          const show = filter === "all" || section.dataset.category === filter;
          section.style.display = show ? "" : "none";
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initCatalogFilters);
</script>
