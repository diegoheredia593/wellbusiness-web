---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CtaBanner from "../components/CtaBanner.astro";
import MotorolaBadge from "../components/MotorolaBadge.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { getBlocks, marcaDe, contactoDe, getMarcas, getValores } from "../lib/content";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const [marcas, valores] = await Promise.all([getMarcas(), getValores()]);
---

<BaseLayout
  title="Nosotros"
  description={b.t('nosotros.meta.descripcion')}
  marca={marca}
  contacto={contacto}
>
  <PageHero
    eyebrow={b.t('nosotros.hero.eyebrow')}
    title={b.t('nosotros.hero.titulo')}
    description={b.t('nosotros.hero.descripcion')}
  />

  <section class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
    <!-- FORMA DE TRABAJAR -->
    <div class="grid gap-6 sm:grid-cols-[auto_1fr]" data-reveal>
      <span class="flex size-12 items-center justify-center rounded-2xl bg-brand-steel-light text-brand-steel-dark">
        <Icon name="compass" class="size-6" />
      </span>
      <div>
        <h2 class="font-display text-2xl font-semibold text-brand-ink">
          {b.t('nosotros.trabajo.titulo')}
        </h2>
        <p class="mt-3 text-base leading-relaxed text-brand-slate">
          {b.t('nosotros.trabajo.descripcion')}
        </p>
      </div>
    </div>

    <!-- RESPALDO MOTOROLA -->
    <div class="mt-14 rounded-3xl border border-brand-mist bg-white p-8" data-reveal>
      <MotorolaBadge label={marca.dealerMotorola} variant="full" />
      <p class="mt-5 text-base leading-relaxed text-brand-slate">
        {b.t('nosotros.motorola.parrafo')}
      </p>
    </div>

    <!-- IDROCOMSOLUTIONS -->
    <div class="mt-8 rounded-3xl border border-brand-mist bg-white p-8" data-reveal>
      <div class="flex flex-wrap items-center gap-3">
        <span class="flex size-12 items-center justify-center rounded-2xl bg-brand-steel-light text-brand-steel-dark">
          <Icon name="building" class="size-6" />
        </span>
        <h2 class="font-display text-xl font-semibold text-brand-ink">Relación con {marca.empresaMadre}</h2>
      </div>
      <p class="mt-4 text-base leading-relaxed text-brand-slate">
        {b.t('nosotros.idrocom.parrafo')}
      </p>
    </div>

    <!-- MISIÓN Y VISIÓN -->
    <div class="mt-8 rounded-3xl border border-brand-mist bg-white p-8" data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.1em] text-brand-steel">{b.t('nosotros.trayectoria.texto')}</p>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="font-display text-lg font-semibold text-brand-ink">Misión</h2>
          <p class="mt-3 text-base leading-relaxed text-brand-slate">{b.t('nosotros.mision.texto')}</p>
        </div>
        <div>
          <h2 class="font-display text-lg font-semibold text-brand-ink">Visión</h2>
          <p class="mt-3 text-base leading-relaxed text-brand-slate">{b.t('nosotros.vision.texto')}</p>
        </div>
      </div>
    </div>

    <!-- VALORES -->
    <div class="mt-8 rounded-3xl border border-brand-mist bg-white p-8" data-reveal>
      <h2 class="font-display text-xl font-semibold text-brand-ink">{b.t('nosotros.valores.titulo')}</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {valores.map((value) => (
          <div class="flex items-start gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-steel-light text-brand-steel-dark">
              <Icon name={value.icon} class="size-5" />
            </span>
            <div>
              <h3 class="font-display text-base font-semibold text-brand-ink">{value.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-brand-slate">{value.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MARCAS QUE HAN CONFIADO EN NOSOTROS -->
  <section class="border-y border-brand-mist bg-white py-14">
    <div class="mx-auto max-w-7xl px-5 sm:px-8" data-reveal>
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.14em] text-brand-slate">
        {b.t('nosotros.marcas.etiqueta')}
      </p>
      <LogoMarquee logos={marcas} />
    </div>
  </section>

  <CtaBanner
    title={b.t('nosotros.cta.titulo')}
    ctaLabel={b.t('nosotros.cta.ctaLabel')}
    ctaHref="/contacto"
  />
</BaseLayout>
