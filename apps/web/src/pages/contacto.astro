---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactForm from "../components/ContactForm.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import { getBlocks, marcaDe, contactoDe, getFaq } from "../lib/content";
import { whatsappLink } from "../utils/whatsapp";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const faq = await getFaq();

const hasAnyContact = Object.values(contacto).some(Boolean);
const mapsHref = contacto.direccion
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contacto.direccion)}`
  : undefined;
---

<BaseLayout
  title="Contacto"
  description={b.t('contacto.meta.descripcion')}
  marca={marca}
  contacto={contacto}
>
  <PageHero
    eyebrow={b.t('contacto.hero.eyebrow')}
    title={b.t('contacto.hero.titulo')}
    description={b.t('contacto.hero.descripcion')}
  />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div class="rounded-3xl border border-brand-mist bg-white p-6 sm:p-8" data-reveal>
        <ContactForm />
      </div>

      <aside class="space-y-6" data-reveal style="animation-delay:80ms">
        <div class="rounded-3xl border border-brand-mist bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-brand-ink">Contacto directo</h3>

          {contacto.whatsapp && (
            <a
              href={whatsappLink(contacto.whatsapp, "Hola, quisiera más información sobre sus equipos.")}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 text-sm font-semibold text-white shadow-brand-sm transition-transform hover:scale-[1.02]"
            >
              <Icon name="whatsapp" class="size-4" />
              Escribir por WhatsApp
            </a>
          )}

          <ul class="mt-5 space-y-3">
            {contacto.telefono && (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                  <Icon name="phone" class="size-4" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">Teléfono</p>
                  <a href={`tel:${contacto.telefono.replace(/\s/g, "")}`} class="font-medium text-brand-ink hover:text-brand-steel">
                    {contacto.telefono}
                  </a>
                </div>
              </li>
            )}
            {contacto.correo && (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                  <Icon name="mail" class="size-4" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">Correo</p>
                  <a href={`mailto:${contacto.correo}`} class="font-medium text-brand-ink hover:text-brand-steel">
                    {contacto.correo}
                  </a>
                </div>
              </li>
            )}
            {contacto.direccion && (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                  <Icon name="pin" class="size-4" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">Dirección</p>
                  <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-ink hover:text-brand-steel">
                    {contacto.direccion}
                  </a>
                </div>
              </li>
            )}
            {contacto.facebook && (
              <li class="flex items-center gap-3 text-sm">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                  <Icon name="facebook" class="size-4" />
                </span>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">Facebook</p>
                  <a href={contacto.facebook} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-ink hover:text-brand-steel">
                    Wellbusiness
                  </a>
                </div>
              </li>
            )}
            <li class="flex items-center gap-3 text-sm">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                <Icon name="clock" class="size-4" />
              </span>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">Horario de atención</p>
                {contacto.horario ? (
                  <p class="font-medium text-brand-ink">{contacto.horario}</p>
                ) : (
                  <p class="text-brand-slate/70">Pendiente de confirmación</p>
                )}
              </div>
            </li>
          </ul>

          {!hasAnyContact && (
            <p class="mt-5 rounded-xl bg-brand-steel-light px-3.5 py-3 text-xs leading-relaxed text-brand-steel-dark">
              Estos canales se están confirmando con Wellbusiness. Mientras tanto, el formulario es la forma más
              rápida de contactarnos.
            </p>
          )}
        </div>

        <div class="rounded-3xl bg-brand-ink p-6 text-white">
          <h3 class="font-display text-lg font-semibold">¿Prefieres que te contactemos?</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Completa el formulario con tu motivo de consulta y te responderemos a la brevedad.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <SectionHeading align="center" class="mx-auto mb-10" title="Preguntas frecuentes" />
      <Faq items={faq} />
    </div>
  </section>
</BaseLayout>
