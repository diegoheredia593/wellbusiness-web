---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectorCard from "../components/SectorCard.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { getBlocks, marcaDe, contactoDe, getSectores } from "../lib/content";

const b = await getBlocks();
const marca = marcaDe(b);
const contacto = contactoDe(b);
const sectores = await getSectores();
---

<BaseLayout
  title="Sectores"
  description={b.t('sectores.meta.descripcion')}
  marca={marca}
  contacto={contacto}
>
  <PageHero
    eyebrow={b.t('sectores.hero.eyebrow')}
    title={b.t('sectores.hero.titulo')}
    description={b.t('sectores.hero.descripcion')}
  />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {sectores.map((sector, i) => <SectorCard sector={sector} index={i} />)}
    </div>
  </section>

  <CtaBanner
    title={b.t('sectores.cta.titulo')}
    ctaLabel={b.t('sectores.cta.ctaLabel')}
    ctaHref="/contacto"
  />
</BaseLayout>
