---
import Portal from '@/layouts/Portal.astro';
import FormularioItem from '@/components/FormularioItem';
import { valorInicial } from '@cms/core/campos';
import { camposDe, definicion, enRevision, opcionesRelacion } from '@/lib/servidor/items';
import { nuevo } from '@/lib/textos';

const nombre = Astro.params.nombre ?? '';
const def = definicion(nombre);
if (!def) return Astro.rewrite('/404');
const usuario = Astro.locals.usuario!;
const campos = camposDe(nombre);
const valores = Object.fromEntries(campos.map((c) => [c.nombre, valorInicial(c)]));
const relaciones = await opcionesRelacion(campos);
---

<Portal titulo={nuevo(def)} antetitulo={def.etiqueta} volver={{ href: `/colecciones/${nombre}`, texto: def.etiqueta }}>
  <FormularioItem
    client:load
    coleccion={nombre}
    nombres={{ singular: def.singular, genero: def.genero, etiqueta: def.etiqueta }}
    campos={campos}
    valores={valores}
    pendientes={null}
    relaciones={relaciones}
    esAdmin={usuario.rol === 'admin'}
    enRevision={enRevision(usuario)}
    puedeEliminar={false}
  />
</Portal>
