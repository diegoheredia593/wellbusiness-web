---
import Simple from '@/layouts/Simple.astro';
import FormularioSimple from '@/components/FormularioSimple';
import { hayAdmin } from '@/lib/servidor/usuarios';

if (Astro.locals.usuario) return Astro.redirect('/');

const pedido = Astro.url.searchParams.get('volver') ?? '/';
// Solo rutas internas del portal (evita redirecciones a otros sitios).
const destino = /^\/(?!\/)[\w\-/?=&%.]*$/.test(pedido) ? pedido : '/';
const sinAdmin = !(await hayAdmin());
---

<Simple titulo="Entrar">
  {
    sinAdmin && (
      <p class="aviso aviso-info mb-5">
        Todavía no hay administrador. Si acabas de instalar el portal, ve a la
        <a class="enlace" href="/configuracion-inicial">configuración inicial</a>.
      </p>
    )
  }
  <FormularioSimple
    client:load
    endpoint="/api/auth/sign-in/email"
    boton="Entrar"
    destino={destino}
    campos={[
      { nombre: 'email', etiqueta: 'Correo', tipo: 'email', autocomplete: 'username' },
      { nombre: 'password', etiqueta: 'Contraseña', tipo: 'password', autocomplete: 'current-password' },
    ]}
  />
  <p class="ayuda mt-5">¿Olvidaste tu contraseña? Pídele al administrador un enlace para crear una nueva.</p>
</Simple>
