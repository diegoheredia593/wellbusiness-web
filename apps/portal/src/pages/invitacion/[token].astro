---
import Simple from '@/layouts/Simple.astro';
import FormularioSimple from '@/components/FormularioSimple';
import MensajeEnlace from '@/components/MensajeEnlace.astro';
import { comprobarEnlace } from '@/lib/servidor/enlaces';
import { LONGITUD_MINIMA } from '@/lib/servidor/contrasenas';

const token = Astro.params.token ?? '';
const estado = await comprobarEnlace('invitacion', token);
if (!estado.valido) Astro.response.status = 410;
---

<Simple titulo="Crea tu cuenta">
  {
    estado.valido ? (
      <>
        <p class="mb-5 text-tinta-suave">Te invitaron al portal. Elige tu contraseña para entrar.</p>
        <FormularioSimple
          client:load
          endpoint="/api/publico/invitacion"
          boton="Crear mi cuenta"
          destino="/entrar"
          exito="Tu cuenta está lista. Ahora entra con tu correo y contraseña."
          extra={{ token }}
          campos={[
            {
              nombre: 'email',
              etiqueta: 'Correo',
              tipo: 'email',
              valor: estado.enlace.email,
              soloLectura: true,
              autocomplete: 'username',
            },
            { nombre: 'nombre', etiqueta: 'Tu nombre', valor: estado.enlace.nombre ?? '', autocomplete: 'name' },
            {
              nombre: 'contrasena',
              etiqueta: 'Contraseña',
              tipo: 'password',
              autocomplete: 'new-password',
              ayuda: `Al menos ${LONGITUD_MINIMA} caracteres. Una frase de varias palabras es fácil de recordar y segura.`,
            },
          ]}
        />
      </>
    ) : (
      <MensajeEnlace motivo={estado.motivo} tipo="invitacion" />
    )
  }
</Simple>
