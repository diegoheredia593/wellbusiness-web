{
  "name": "wellbusiness-portal",
  "account_id": "84ffa5d2db10e557297317693d5ae3bf",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": "../../apps/portal/dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wellbusiness-db",
      "database_id": "2afc8400-5ed4-423d-bf72-27f7cee8ece0"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIOS",
      "id": "76a57ddc1568418ebaeb3c2d6bd8e8d2"
    }
  ],
  "observability": { "enabled": true }
}
