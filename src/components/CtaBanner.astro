---
import Button from "./Button.astro";

interface Props {
  title: string;
  description?: string;
  ctaLabel: string;
  ctaHref: string;
}
const { title, description, ctaLabel, ctaHref } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-ink py-16 sm:py-20">
  <div class="absolute inset-0 bg-radio-grid opacity-[0.06]"></div>
  <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-6 px-5 text-center sm:px-8" data-reveal>
    <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">{title}</h2>
    {description && <p class="max-w-xl text-base leading-relaxed text-white/70">{description}</p>}
    <Button href={ctaHref} variant="primary" size="lg">{ctaLabel}</Button>
  </div>
</section>
