---
/**
 * Real Wellbusiness logo assets (`public/images/brand/`), used as supplied
 * — never recolored/redrawn/altered.
 *
 * `wellbusiness-logo.png` is the full lockup (icon + "WellBusiness"
 * wordmark) — its wordmark is dark text, so it only reads on a LIGHT
 * background (`variant="dark"`, the default: header, white cards, etc.).
 *
 * On a DARK background (`variant="light"`: footer, dark hero panels, the
 * mobile menu) the full lockup's black text would disappear, so this pairs
 * the real icon-only mark (`wellbusiness-isologo.png`, untouched) with a
 * plain white text label instead of the bitmap wordmark — same convention
 * a two-piece lockup (icon mark + adaptable wordmark color) normally uses.
 */
interface Props {
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;
---

{variant === "dark" ? (
  <a href="/" class={`inline-flex items-center ${className}`} aria-label="Wellbusiness — Inicio">
    <img
      src="/images/brand/wellbusiness-logo.png"
      alt="Wellbusiness"
      class="h-9 w-auto sm:h-10"
      width="450"
      height="100"
    />
  </a>
) : (
  <a href="/" class={`inline-flex items-center gap-2.5 ${className}`} aria-label="Wellbusiness — Inicio">
    <img src="/images/brand/wellbusiness-isologo.png" alt="" class="h-9 w-9 shrink-0" width="80" height="80" />
    <span class="flex flex-col leading-none">
      <span class="font-display text-lg font-bold tracking-tight text-white">Wellbusiness</span>
      <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-white/60">Idrocomsolutions</span>
    </span>
  </a>
)}
