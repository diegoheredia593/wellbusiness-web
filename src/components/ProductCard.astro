---
import ImagePlaceholder from "./ImagePlaceholder.astro";
import Icon from "./Icon.astro";
import Badge from "./Badge.astro";
import { contactHref } from "../utils/url";
import type { Product } from "../data/types";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const visibleSpecs = product.specs.slice(0, 4);
const extraSpecCount = product.specs.length - visibleSpecs.length;
---

<article
  id={product.slug}
  class="flex flex-col overflow-hidden rounded-2xl border border-brand-mist bg-white shadow-brand-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-brand-md"
  data-reveal
  data-category={product.category}
>
  {product.images.length > 0 ? (
    <div class="group relative aspect-[4/3] overflow-hidden bg-white" data-gallery>
      <img
        src={product.images[0]}
        alt={product.name}
        class="h-full w-full object-contain p-6 transition-transform duration-500 ease-out group-hover:scale-110"
        data-gallery-main
        loading="lazy"
        decoding="async"
      />
      <span class="pointer-events-none absolute right-3 top-3 flex size-8 items-center justify-center rounded-full bg-white/95 text-brand-ink opacity-0 shadow-brand-sm transition-opacity duration-200 group-hover:opacity-100">
        <Icon name="zoom" class="size-4" />
      </span>
      {product.images.length > 1 && (
        <div class="absolute inset-x-0 bottom-0 flex justify-center gap-1.5 bg-gradient-to-t from-white/95 via-white/70 to-transparent px-3 pb-2.5 pt-8">
          {product.images.map((src, i) => (
            <button
              type="button"
              data-thumb
              data-src={src}
              aria-label={`Ver foto ${i + 1} de ${product.name}`}
              aria-current={i === 0 ? "true" : "false"}
              class={`h-1.5 rounded-full transition-all duration-200 ${i === 0 ? "w-5 bg-brand-red" : "w-1.5 bg-brand-ink/20 hover:bg-brand-ink/45"}`}
            />
          ))}
        </div>
      )}
    </div>
  ) : (
    <ImagePlaceholder class="aspect-[4/3]" icon="radio-handheld" note={`Fotografía de ${product.name}`} />
  )}

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display text-lg font-semibold text-brand-ink">{product.name}</h3>
      {product.isPlaceholder && <Badge tone="mist">Ejemplo</Badge>}
    </div>
    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-brand-steel">
      {product.type} · {product.band}
    </p>
    <p class="mt-3 text-sm leading-relaxed text-brand-slate">{product.summary}</p>

    {visibleSpecs.length > 0 && (
      <ul class="mt-4 space-y-1.5">
        {visibleSpecs.map((spec) => (
          <li class="flex items-start gap-2 text-sm text-brand-ink-soft">
            <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-brand-steel" />
            {spec}
          </li>
        ))}
      </ul>
    )}
    {extraSpecCount > 0 && (
      <p class="mt-1.5 pl-5 text-xs font-medium text-brand-slate">+{extraSpecCount} especificaciones más</p>
    )}

    {product.applications.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {product.applications.map((app) => <Badge tone="steel">{app}</Badge>)}
      </div>
    )}

    <div class="mt-6 flex flex-col gap-1.5">
      <a
        href={contactHref({ motive: "Catálogo Motorola", product: product.name })}
        class="inline-flex items-center justify-center gap-1.5 rounded-full bg-brand-ink px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-ink-soft"
      >
        Consultar este producto
      </a>
      <p class="text-center text-xs text-brand-slate">
        Te ayudamos a confirmar disponibilidad y compatibilidad con tu sistema.
      </p>
    </div>
  </div>
</article>

<script>
  // Shared by every ProductCard on the page (Astro hoists/dedupes this
  // module once). Swaps the main photo when a gallery dot is clicked or
  // hovered — no lightbox, no library, just the <img src> and the dots'
  // active state.
  function initProductGalleries() {
    document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
      const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-thumb]");
      if (!main || thumbs.length < 2) return;

      const activate = (btn: HTMLButtonElement) => {
        const src = btn.dataset.src;
        if (!src || main.src.endsWith(src)) return;
        main.src = src;
        thumbs.forEach((t) => {
          const active = t === btn;
          t.setAttribute("aria-current", String(active));
          t.classList.toggle("w-5", active);
          t.classList.toggle("bg-brand-red", active);
          t.classList.toggle("w-1.5", !active);
          t.classList.toggle("bg-brand-ink/20", !active);
        });
      };

      thumbs.forEach((btn) => {
        btn.addEventListener("click", () => activate(btn));
        btn.addEventListener("mouseenter", () => activate(btn));
      });
    });
  }

  document.addEventListener("astro:page-load", initProductGalleries);
</script>
