---
/**
 * Large product image viewer for the catalog detail page: arrow navigation
 * between real photos + a hover-zoom effect on the main image (desktop
 * only — same "amplía sin salir de la imagen" idea as a typical e-commerce
 * product page, no lightbox/library). Falls back to the brand
 * ImagePlaceholder when a product has no real photos yet.
 */
import Icon from "./Icon.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  images: string[];
  name: string;
}
const { images, name } = Astro.props;
const hasImages = images.length > 0;
const hasMultiple = images.length > 1;
---

{hasImages ? (
  <div class="lg:sticky lg:top-24">
    <div
      class="group relative aspect-square overflow-hidden rounded-3xl border border-brand-mist bg-white"
      data-gallery
      data-index="0"
      tabindex="0"
      aria-label={`Fotografías de ${name}. Usa las flechas para cambiar de foto.`}
    >
      <img
        src={images[0]}
        alt={name}
        class="relative z-0 h-full w-full object-contain p-10 sm:p-14"
        data-gallery-main
        loading="eager"
        decoding="async"
      />
      <div
        class="pointer-events-none absolute inset-0 z-10 hidden bg-no-repeat opacity-0 transition-opacity duration-150 lg:block"
        data-zoom-pane
        style={`background-image:url(${images[0]}); background-size:220%;`}
      ></div>

      {hasMultiple && (
        <>
          <button
            type="button"
            data-nav="prev"
            aria-label={`Foto anterior de ${name}`}
            class="absolute left-3 top-1/2 z-20 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-brand-ink shadow-brand-md transition-transform hover:scale-105"
          >
            <Icon name="chevron-right" class="size-4 rotate-180" />
          </button>
          <button
            type="button"
            data-nav="next"
            aria-label={`Foto siguiente de ${name}`}
            class="absolute right-3 top-1/2 z-20 flex size-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-brand-ink shadow-brand-md transition-transform hover:scale-105"
          >
            <Icon name="chevron-right" class="size-4" />
          </button>
        </>
      )}

      <span class="pointer-events-none absolute bottom-3 right-3 z-20 hidden items-center gap-1.5 rounded-full bg-brand-ink/85 px-3 py-1.5 text-[11px] font-medium text-white/90 lg:flex">
        <Icon name="zoom" class="size-3.5" />
        Pasa el cursor para ampliar
      </span>
    </div>

    {hasMultiple && (
      <div class="mt-4 flex gap-3 overflow-x-auto pb-1" data-gallery-thumbs>
        {images.map((src, i) => (
          <button
            type="button"
            data-thumb
            data-src={src}
            data-index={i}
            aria-label={`Ver foto ${i + 1} de ${name}`}
            aria-current={i === 0 ? "true" : "false"}
            class={`flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-xl border-2 bg-white p-1.5 transition-colors sm:size-20 ${
              i === 0 ? "border-brand-red" : "border-brand-mist hover:border-brand-steel"
            }`}
          >
            <img src={src} alt="" class="h-full w-full object-contain" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    )}
  </div>
) : (
  <div class="lg:sticky lg:top-24">
    <ImagePlaceholder class="aspect-square rounded-3xl" icon="radio-handheld" note={`Fotografía de ${name}`} />
  </div>
)}

<script>
  // One gallery per detail page — arrows/thumbnails cycle the main photo,
  // and (desktop + fine pointer only) hovering the main image shows a
  // magnified pane that tracks the cursor, like a typical product page.
  function initProductGallery() {
    const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");
    const canZoom = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    galleries.forEach((gallery) => {
      const main = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
      const zoomPane = gallery.querySelector<HTMLElement>("[data-zoom-pane]");
      const thumbs = Array.from(gallery.parentElement?.querySelectorAll<HTMLButtonElement>("[data-thumb]") ?? []);
      if (!main) return;

      let index = 0;

      const setIndex = (next: number) => {
        const total = thumbs.length || 1;
        index = ((next % total) + total) % total;
        const src = thumbs[index]?.dataset.src ?? main.src;
        main.src = src;
        if (zoomPane) zoomPane.style.backgroundImage = `url(${src})`;
        gallery.dataset.index = String(index);

        thumbs.forEach((t, i) => {
          const active = i === index;
          t.setAttribute("aria-current", String(active));
          t.classList.toggle("border-brand-red", active);
          t.classList.toggle("border-brand-mist", !active);
          t.classList.toggle("hover:border-brand-steel", !active);
        });
      };

      thumbs.forEach((btn, i) => btn.addEventListener("click", () => setIndex(i)));

      gallery.querySelector("[data-nav='prev']")?.addEventListener("click", () => setIndex(index - 1));
      gallery.querySelector("[data-nav='next']")?.addEventListener("click", () => setIndex(index + 1));

      gallery.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") setIndex(index - 1);
        if (e.key === "ArrowRight") setIndex(index + 1);
      });

      if (canZoom && zoomPane) {
        gallery.addEventListener("mouseenter", () => {
          zoomPane.style.opacity = "1";
        });
        gallery.addEventListener("mousemove", (e) => {
          const rect = gallery.getBoundingClientRect();
          const x = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
          const y = Math.min(100, Math.max(0, ((e.clientY - rect.top) / rect.height) * 100));
          zoomPane.style.backgroundPosition = `${x}% ${y}%`;
        });
        gallery.addEventListener("mouseleave", () => {
          zoomPane.style.opacity = "0";
        });
      }
    });
  }

  document.addEventListener("astro:page-load", initProductGallery);
</script>
