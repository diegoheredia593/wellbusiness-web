---
interface Props {
  tone?: "steel" | "mist" | "red" | "outline";
  class?: string;
}
const { tone = "steel", class: className = "" } = Astro.props;

const tones = {
  steel: "bg-brand-steel-light text-brand-steel-dark",
  mist: "bg-brand-mist text-brand-slate",
  red: "bg-brand-red/10 text-brand-red-dark",
  outline: "border border-brand-ink/15 text-brand-slate",
};
---

<span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold tracking-wide ${tones[tone]} ${className}`}>
  <slot />
</span>
