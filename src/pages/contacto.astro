---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ContactForm from "../components/ContactForm.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import { CONTACT_INFO } from "../data/site";

const hasAnyContact = Object.values(CONTACT_INFO).some(Boolean);

const contactRows = [
  { key: "whatsapp", icon: "whatsapp" as const, label: "WhatsApp" },
  { key: "phone", icon: "phone" as const, label: "Teléfono" },
  { key: "email", icon: "mail" as const, label: "Correo" },
  { key: "address", icon: "pin" as const, label: "Dirección" },
  { key: "hours", icon: "clock" as const, label: "Horario de atención" },
] as const;
---

<BaseLayout
  title="Contacto"
  description="Consulta radios Motorola, alquiler, soporte técnico, cobertura e infraestructura para tu empresa."
>
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de lo que tu operación necesita"
    description="Déjanos tus datos y cuéntanos si buscas radios, alquiler, servicio técnico, cobertura o asesoría de ingeniería. El equipo de Wellbusiness se pondrá en contacto contigo."
  />

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <div class="rounded-3xl border border-brand-mist bg-white p-6 sm:p-8" data-reveal>
        <ContactForm />
      </div>

      <aside class="space-y-6" data-reveal style="animation-delay:80ms">
        <div class="rounded-3xl border border-brand-mist bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-brand-ink">Contacto directo</h3>
          <ul class="mt-4 space-y-3">
            {contactRows.map((row) => {
              const value = CONTACT_INFO[row.key];
              return (
                <li class="flex items-center gap-3 text-sm">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-steel-light text-brand-steel-dark">
                    <Icon name={row.icon} class="size-4" />
                  </span>
                  {value ? (
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">{row.label}</p>
                      <p class="font-medium text-brand-ink">{value}</p>
                    </div>
                  ) : (
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wide text-brand-slate">{row.label}</p>
                      <p class="text-brand-slate/70">Pendiente de confirmación</p>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
          {!hasAnyContact && (
            <p class="mt-5 rounded-xl bg-brand-steel-light px-3.5 py-3 text-xs leading-relaxed text-brand-steel-dark">
              Estos canales se están confirmando con Wellbusiness. Mientras tanto, el formulario es la forma más
              rápida de contactarnos.
            </p>
          )}
        </div>

        <div class="rounded-3xl bg-brand-ink p-6 text-white">
          <h3 class="font-display text-lg font-semibold">¿Prefieres que te contactemos?</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">
            Completa el formulario con tu motivo de consulta y te responderemos a la brevedad.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <SectionHeading align="center" class="mx-auto mb-10" title="Preguntas frecuentes" />
      <Faq />
    </div>
  </section>
</BaseLayout>
